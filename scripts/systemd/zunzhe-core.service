[Unit]
Description=Zunzhe live/video monitor Rust core daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zunzhe
WorkingDirectory=/opt/zunzhe
ExecStart=/bin/bash /opt/zunzhe/scripts/start-rust-daemon.sh --interval 900
Restart=always
RestartSec=5
Environment=RUST_LOG=info
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
