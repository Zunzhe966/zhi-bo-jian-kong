#!/bin/bash
# Zig 0.16 linker adapter for Rust's x86_64-unknown-linux-gnu target.
set -euo pipefail

ZIG="${ZIG_CC:-$HOME/.local/opt/zig-aarch64-macos-0.16.0/zig}"
args=(-target x86_64-linux-gnu)
for arg in "$@"; do
  case "$arg" in
    -m64) ;; # Zig target already selects 64-bit.
    *) args+=("$arg") ;;
  esac
done
exec "$ZIG" cc "${args[@]}"
